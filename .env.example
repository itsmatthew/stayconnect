# stayconnect environment variables
# Copy this file to .env.local and fill in real values — never commit .env.local.

# ---------------------------------------------------------------------------
# Public (safe to share) — bundled into client JS (NEXT_PUBLIC_ prefix)
# ---------------------------------------------------------------------------

# Clerk dashboard > Configure > API Keys > Publishable key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Server-only (do not share) — never exposed to the browser
# ---------------------------------------------------------------------------

# Clerk dashboard > Configure > API Keys > Secret key
CLERK_SECRET_KEY=

# Neon Postgres connection string — Vercel dashboard > Storage > (your Neon database) > .env.local tab
# (or Neon console > Connection Details)
DATABASE_URL=
